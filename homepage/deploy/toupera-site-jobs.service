[Unit]
Description=Toupeira site contract workflow
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=toupera
Group=toupera
WorkingDirectory=/srv/toupera-agent
ExecStartPre=/usr/bin/test -x /usr/bin/bwrap
ExecStart=/usr/bin/python3 /srv/toupera-agent/tools/site_jobs.py serve
Restart=always
RestartSec=3
NoNewPrivileges=true
UMask=0077
ProtectSystem=strict
ReadWritePaths=/srv/toupera-agent/private-output /home/toupera/.cache /home/toupera/.foundry /home/toupera/.mythril /home/toupera/.halmos /home/toupera/.config /home/toupera/.solc-select /home/toupera/.solcx /home/toupera/.local/state /home/toupera/.local/share
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
